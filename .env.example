# GEMINI_API_KEY: Optional Gemini API key if extending with AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret string used to sign HttpOnly admin session cookies.
# Generate a strong random 32+ character secret in production.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_SECRET"

# ADMIN_EMAIL & ADMIN_PASSWORD: Optional initial admin credentials seeded on first boot.
# Leave unset to configure the administrator account interactively via the /admin setup screen on first launch.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
